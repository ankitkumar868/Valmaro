<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="50dp"
        android:paddingBottom="16dp">

        <!-- ========================= -->
        <!-- SEARCH + LOGO -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SearchView
                android:id="@+id/searchView"
                android:layout_width="280dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_color"
                android:queryHint="Search Products..." />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/chatgpt_image_sep_5__2026__12_08_16_pm"
                android:contentDescription="Valmaro Logo" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- BANNER -->
        <!-- ========================= -->


        <!-- ========================= -->
        <!-- CATEGORIES -->
        <!-- ========================= -->

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/bannerSlider"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="10dp"
            android:contentDescription="Valmaro Banner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Categories"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ========================= -->
        <!-- AI ASSISTANT -->
        <!-- ========================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/aiAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="#EEEEEE">

            <!-- AI TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤖 Ask Valmaro AI"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFA500" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tell us what you need and we'll find suitable products"
                android:textSize="13sp"
                android:textColor="#666666" />


            <!-- USER REQUIREMENT -->

            <EditText
                android:id="@+id/aiNeedInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_color"
                android:hint="Example: I need running shoes"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2" />


            <!-- FIND BUTTON -->

            <Button
                android:id="@+id/findProductsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFA500"
                android:text="FIND FOR ME" />


            <!-- AI RESULT TITLE -->

            <TextView
                android:id="@+id/aiResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="🤖 Recommended For You"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:visibility="gone" />


            <!-- AI RECOMMENDED PRODUCTS -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/aiProductsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- POPULAR PRODUCTS -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Popular Products"
            android:textStyle="bold"
            android:textSize="17sp" />

        <com.example.valmaro.ExpandableRecyclerView
            android:id="@+id/productRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

</ScrollView>