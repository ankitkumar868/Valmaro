<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- SCROLLABLE PRODUCT CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- PRODUCT IMAGE SECTION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F6F6F6"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/detailProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Product Image" />

            </LinearLayout>

            <!-- PRODUCT INFORMATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CATEGORY -->

                <TextView
                    android:id="@+id/detailProductCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: Shoes"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- PRODUCT NAME -->

                <TextView
                    android:id="@+id/detailProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Running Shoes"
                    android:textColor="#171717"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="sans" />

                <!-- RATING -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/detailProductRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 4.5"
                        android:textColor="#444444"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- PRICE -->

                <TextView
                    android:id="@+id/productPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹2000"
                    android:textSize="20sp"
                    android:textColor="#888888"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/detailOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹2000"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:visibility="gone"/>

               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal">

                   <TextView
                       android:id="@+id/detailDiscountPrice"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="₹1499"
                       android:layout_marginLeft="10dp"
                       android:textSize="25sp"
                       android:textStyle="bold"
                       android:textColor="#0B6E4F"
                       android:visibility="gone"
                       />

                   <TextView
                       android:id="@+id/detailDiscountBadge"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="25% OFF"
                       android:textColor="#FFFFFF"
                       android:background="#FF9800"
                       android:padding="5dp"
                       android:layout_marginLeft="10dp"
                       android:textStyle="bold"
                       android:textSize="12sp"
                       android:visibility="gone"/>
               </LinearLayout>

                <TextView
                    android:id="@+id/detailYouSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#0B6E4F"
                    android:visibility="gone" />
                <!-- STOCK -->

                <TextView
                    android:id="@+id/detailProductStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Stock: 20"
                    android:textColor="#238636"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- PRICE PREDICTION CARD -->

                <LinearLayout
                    android:id="@+id/pricePredictionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#FFF7E8">

                    <!-- Card Heading -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📈 Price Prediction"
                        android:textColor="#7A4A00"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Prediction Period -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Estimated price after 7 days"
                        android:textColor="#8A6A3B"
                        android:textSize="13sp" />

                    <!-- Predicted Price -->

                    <TextView
                        android:id="@+id/predictedPriceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Calculating..."
                        android:textColor="#222222"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Expected Savings -->

                    <TextView
                        android:id="@+id/predictedSavingsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Calculating savings..."
                        android:textColor="#238636"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Price Trend -->

                    <TextView
                        android:id="@+id/priceTrendText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Analyzing price trend..."
                        android:textColor="#555555"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#EEEEEE" />

                <!-- DESCRIPTION TITLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Product Description"
                    android:textColor="#171717"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- DESCRIPTION -->

                <TextView
                    android:id="@+id/detailProductDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Comfortable and stylish product for everyday use."
                    android:textColor="#666666"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

                <!-- CUSTOMER RATING SECTION -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Rate This Product"
                    android:textColor="#171717"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/customerRatingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="1"
                    android:isIndicator="false"
                    android:progressTint="#F5A623"
                    android:secondaryProgressTint="#F5A623" />

                <!-- SUBMIT RATING -->

                <Button
                    android:id="@+id/submitRatingButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#222222"
                    android:text="Submit Rating"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textAllCaps="false" />

                <!-- RELATED PRODUCTS -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/relatedProductsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="14dp"
                    android:text="You May Also Like"
                    android:textColor="#171717"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/relatedProductsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- FIXED BOTTOM BUTTONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <Button
            android:id="@+id/detailAddToCart"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#222222"
            android:text="Add to Cart"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/detailBuyNow"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F5A623"
            android:text="Buy Now"
            android:textColor="#171717"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>