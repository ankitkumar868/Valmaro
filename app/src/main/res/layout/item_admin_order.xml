<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/adminProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/adminOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Order ID: VM12345"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/adminCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Customer: Ankit"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adminPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: 9876543210"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adminAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adminQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Quantity: 1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adminPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: ₹1499"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminCurrentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Confirmed"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <Spinner
            android:id="@+id/adminStatusSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/updateStatusButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFA500"
            android:layout_marginTop="8dp"
            android:text="UPDATE STATUS" />

    </LinearLayout>

</androidx.cardview.widget.CardView>